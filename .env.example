# === Anthropic ===
ANTHROPIC_API_KEY=

# === Supabase ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# === Database (local docker) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/despacho

# === Evolution API (Hostinger) ===
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=

# === CORS (comma-separated, for production) ===
CORS_ORIGINS=https://your-app.vercel.app

# === n8n ===
N8N_WEBHOOK_BASE=

# === Ingesta (Fase 2) ===
INGEST_EMAIL_SECRET=
INGEST_MAX_DOCS_PER_CLIENT_DAY=50
INGEST_MAX_FILE_BYTES=10485760
STORAGE_BUCKET=documents

# === App ===
APP_ENV=development
DEFAULT_TIMEZONE=America/Bogota
DIAN_CALENDAR_YEAR=2026
LOG_LEVEL=INFO

# === Frontend ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
